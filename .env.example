# Database configuration
DATABASE_URL="postgresql://user:password@localhost:5432/hoj_hostel"

# Authentication secret
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary or similar for image uploads
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Email Configuration (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASSWORD="smtp_password"
EMAIL_FROM="House of Jesse <noreply@hojhostel.com>"

# Admin seed secret (optional, to create super admin)
ADMIN_SECRET="secret_admin_creation_token"
